# =====================================================================
# Variaveis do PAINEL — modelo. Copie para /etc/aprovador-painel.env
# (o instalador faz isso na primeira vez) e preencha. chmod 600.
# Formato: CHAVE=valor, um por linha, sem aspas e sem "export".
# =====================================================================

# Endereco da API .NET vista pelo SERVIDOR do painel (mesma maquina: 127.0.0.1).
NFE_API_URL=http://127.0.0.1:5240

# MESMO valor do NFE_API_TOKEN da API (token mestre). Fica so no servidor;
# o navegador nunca recebe este token.
NFE_API_TOKEN=TROQUE_AQUI

# Login do painel.
PAINEL_ADMIN_USUARIO=admin
PAINEL_ADMIN_SENHA=TROQUE_AQUI

# Assina o cookie de sessao. Gere com: openssl rand -base64 48
PAINEL_SESSION_SECRET=TROQUE_AQUI

# Onde a tela "Configuracao da API" grava URL/token. Fora da pasta do projeto
# para sobreviver a novos deploys.
PAINEL_DATA_DIR=/var/lib/aprovador-painel

# Opcional: forca SEMPRE esta URL de API (ex.: painel de testes apontando para
# homologacao). Normalmente deixe comentado.
# NFE_API_URL_FIXA=https://api-teste.exemplo.com.br
