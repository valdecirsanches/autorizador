# v0 sandbox internal files
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts
.snowflake/
.v0-trash/
.vercel/

# Environment variables
.env*.local

# Configuracao de runtime do painel (URL/token da API definidos pela tela
# "Configuracao da API"). E estado local do servidor, nao codigo.
.painel-data/

# Common ignores
node_modules
.next/
.DS_Store
backend/schemas/
backend/NFe.Tests/

# .NET build artifacts — NUNCA versionar. Sao gerados por `dotnet build/run`.
# Versiona-los faz o `dotnet run` do cliente tentar executar um apphost obsoleto
# vindo do pull (ex.: erro "The application to execute does not exist").
[Bb]in/
[Oo]bj/
*.user


# XMLs das notas espelhados em disco (uma pasta por empresa). Gerados em runtime;
# a base e configuravel por NFE_XML_DIR. Nunca versionar documentos fiscais.
xmls/
backend/**/xmls/
