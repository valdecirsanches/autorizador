# =====================================================================
# Variaveis de ambiente da API NFe — modelo.
#
# Copie para um arquivo REAL fora do git e preencha os valores:
#   sudo cp backend/deploy/aprovador-nfe.env.example /etc/aprovador-nfe.env
#   sudo nano /etc/aprovador-nfe.env
#   sudo chmod 600 /etc/aprovador-nfe.env      # protege segredos
#
# O instalador aponta o servico para /etc/aprovador-nfe.env por padrao.
# Formato: CHAVE=valor, um por linha, SEM aspas e SEM "export".
# =====================================================================

# --- OBRIGATORIAS ---

# String de conexao MySQL. Ajuste servidor/usuario/senha/banco.
MYSQL_CONNECTION_STRING=Server=127.0.0.1;Port=3306;Database=nfe;User Id=nfe;Password=TROQUE_AQUI;

# Chave mestra que decifra os certificados A1 guardados no banco.
# Use a MESMA que voce ja usa hoje ao rodar via terminal.
NFE_CERT_MASTER_KEY=TROQUE_AQUI

# Token de acesso a API. TODA requisicao precisa mandar:
#   Authorization: Bearer <este valor>
# A API NAO inicia sem ele. Gere um forte: openssl rand -base64 48
# Use o MESMO valor no painel (variavel NFE_API_TOKEN do Next.js).
NFE_API_TOKEN=TROQUE_AQUI

# --- OPCIONAIS (deixe como esta se nao precisar) ---

# Origens liberadas no CORS (separadas por virgula). "*" libera tudo (evite em producao).
NFE_CORS_ORIGINS=https://seu-painel.exemplo.com

# Pasta onde os XMLs sao gravados (padrao: "xmls" na pasta do app).
# NFE_XML_DIR=/var/lib/aprovador-nfe/xmls

# Pasta dos schemas XSD para validacao (opcional; sem isso a validacao XSD fica off).
# NFE_SCHEMAS_DIR=/opt/aprovador-nfe/schemas

# Aplica migrations automaticamente no start (padrao: true). "false" desliga.
# NFE_AUTO_MIGRATE=true
