# =============================================================================
# ARQUIVO UNICO DE CONFIGURACAO (desenvolvimento local)
#
# Copie este modelo para .env.local e preencha os valores reais:
#   cp .env.example .env.local
#
# Este .env.local fica na RAIZ do projeto e serve os DOIS lados:
#   - Painel Next.js  -> le nativamente
#   - API .NET        -> le automaticamente (sobe a arvore ate achar .env.local)
#
# Assim NAO ha duplicidade: um unico arquivo. O /etc/aprovador-nfe.env so e
# usado quando a API roda como SERVICO systemd (producao) — nunca junto com
# este arquivo. Rodou no terminal? Vale este. Rodou via systemd? Vale o /etc.
#
# .env.local NAO e versionado; este .env.example E versionado (sem segredos).
# =============================================================================

# --- Banco de dados (API .NET) ----------------------------------------------
MYSQL_CONNECTION_STRING=Server=127.0.0.1;Port=3306;Database=nfe_autorizador;User Id=nfeapp;Password=SUA_SENHA;AllowPublicKeyRetrieval=True;SslMode=Disabled;

# --- Cofre de certificados (API .NET) ---------------------------------------
# Gere com: openssl rand -base64 32
NFE_CERT_MASTER_KEY=

# --- Token de acesso a API (OBRIGATORIO) ------------------------------------
# Sem isto a API se recusa a iniciar ([FATAL] NFE_API_TOKEN nao definida).
# Gere com: openssl rand -base64 48
# IMPORTANTE: o painel usa o MESMO valor para falar com a API.
NFE_API_TOKEN=

# --- Schemas XSD da NF-e (API .NET, opcional) -------------------------------
NFE_SCHEMAS_DIR=/caminho/para/schemas/NFe

# --- CORS / integracao painel <-> API (API .NET) ----------------------------
NFE_CORS_ORIGINS=http://localhost:3000
Sefaz__PermitirCadeiaNaoConfiavel=true
NFE_AUTO_MIGRATE=true

# --- Modulo NFS-e (API .NET, opcional) --------------------------------------
# Nao ha URL para configurar: a API escolhe o endpoint do Padrao Nacional
# (producao restrita / producao) pelo ambiente escolhido na chamada. Para
# provedores ABRASF, a URL e configurada por empresa no painel (Configuracao NFS-e).
# Timeout das chamadas ao SEFIN/ADN (segundos). Padrao: 60.
NFSE_TIMEOUT_SEGUNDOS=60
# true = loga o corpo das requisicoes/respostas HTTP da NFS-e (apenas para depuracao).
NFSE_LOG_CORPOS=false

# --- Login do painel (Next.js) ----------------------------------------------
PAINEL_ADMIN_USUARIO=admin
# Defina uma senha forte no seu .env.local (NUNCA preencha aqui neste modelo).
PAINEL_ADMIN_SENHA=TROQUE_AQUI
# Segredo que assina o cookie de sessao. Gere com: openssl rand -base64 48
PAINEL_SESSION_SECRET=TROQUE_AQUI_openssl_rand_base64_48

# --- Endereco da API para o painel (Next.js) --------------------------------
NFE_API_URL=http://127.0.0.1:5240
